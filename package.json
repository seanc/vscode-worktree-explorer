{
  "name": "worktree-explorer",
  "displayName": "Worktree Explorer",
  "description": "Browse and edit a Git linked worktree from a secondary Explorer view, without adding it to your workspace.",
  "version": "0.1.0",
  "publisher": "seanc-local",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/seanc/vscode-worktree-explorer.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "worktree",
    "explorer",
    "tree view"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "worktreeExplorer.files",
          "name": "Worktree Explorer",
          "when": "worktreeExplorer.visible"
        }
      ],
      "worktreeExplorerTickets": [
        {
          "type": "webview",
          "id": "worktreeExplorer.tickets",
          "name": "Tickets"
        }
      ]
    },
    "commands": [
      {
        "command": "worktreeExplorer.selectWorktree",
        "title": "Worktree Explorer: Select Worktree",
        "icon": "$(list-tree)"
      },
      {
        "command": "worktreeExplorer.refresh",
        "title": "Worktree Explorer: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "worktreeExplorer.open",
        "title": "Worktree Explorer: Open File"
      },
      {
        "command": "worktreeExplorer.newFile",
        "title": "Worktree Explorer: New File"
      },
      {
        "command": "worktreeExplorer.newFolder",
        "title": "Worktree Explorer: New Folder"
      },
      {
        "command": "worktreeExplorer.rename",
        "title": "Worktree Explorer: Rename"
      },
      {
        "command": "worktreeExplorer.delete",
        "title": "Worktree Explorer: Delete"
      },
      {
        "command": "worktreeExplorer.copyRelativePath",
        "title": "Worktree Explorer: Copy Relative Path"
      },
      {
        "command": "worktreeExplorer.copyAbsolutePath",
        "title": "Worktree Explorer: Copy Absolute Path"
      },
      {
        "command": "worktreeExplorer.revealInOperatingSystem",
        "title": "Worktree Explorer: Reveal in File Explorer"
      },
      {
        "command": "worktreeExplorer.copyWorktreePath",
        "title": "Worktree Explorer: Copy Worktree Path"
      },
      {
        "command": "worktreeExplorer.revealWorktreeRoot",
        "title": "Worktree Explorer: Reveal Worktree Root"
      },
      {
        "command": "worktreeExplorer.openSettings",
        "title": "Worktree Explorer: Extension Settings"
      },
      {
        "command": "worktreeExplorer.openTicketLink",
        "title": "Worktree Explorer: Open Ticket in Browser",
        "icon": "$(link-external)"
      },
      {
        "command": "worktreeExplorer.openTicketNotes",
        "title": "Worktree Explorer: Open Ticket Notes",
        "icon": "$(note)"
      },
      {
        "command": "worktreeExplorer.copyTestCommand",
        "title": "Worktree Explorer: Copy Test Command",
        "icon": "$(beaker)"
      },
      {
        "command": "worktreeExplorer.chooseFilter",
        "title": "Worktree Explorer: Show Changed Files…",
        "icon": "$(filter)"
      },
      {
        "command": "worktreeExplorer.chooseFilterActive",
        "title": "Worktree Explorer: Show Changed Files (filter on)…",
        "icon": "$(filter-filled)"
      },
      {
        "command": "worktreeExplorer.compareWithBase",
        "title": "Worktree Explorer: Compare with Base Branch"
      },
      {
        "command": "worktreeExplorer.compareWithMainCheckout",
        "title": "Worktree Explorer: Compare with Main Checkout"
      },
      {
        "command": "worktreeExplorer.openInMainCheckout",
        "title": "Worktree Explorer: Open in Main Checkout"
      },
      {
        "command": "worktreeExplorer.openWorktreeInNewWindow",
        "title": "Worktree Explorer: Open Worktree in New Window",
        "icon": "$(empty-window)"
      },
      {
        "command": "worktreeExplorer.showInWorktreeExplorer",
        "title": "Worktree Explorer: Show in Worktree Explorer",
        "icon": "$(eye)"
      },
      {
        "command": "worktreeExplorer.copyCleanupCommand",
        "title": "Worktree Explorer: Copy Cleanup Command"
      },
      {
        "command": "worktreeExplorer.refreshTickets",
        "title": "Worktree Explorer: Refresh Tickets",
        "icon": "$(refresh)"
      },
      {
        "command": "worktreeExplorer.openTicketOverview",
        "title": "Worktree Explorer: Open Ticket Overview",
        "icon": "$(preview)"
      },
      {
        "command": "worktreeExplorer.removeWorktree",
        "title": "Worktree Explorer: Remove Worktree…"
      },
      {
        "command": "worktreeExplorer.serveViaTunnel",
        "title": "Worktree Explorer: Serve Through Tunnel…"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "worktreeExplorer.chooseFilterActive",
          "when": "false"
        },
        {
          "command": "worktreeExplorer.compareWithBase",
          "when": "false"
        },
        {
          "command": "worktreeExplorer.compareWithMainCheckout",
          "when": "false"
        },
        {
          "command": "worktreeExplorer.openInMainCheckout",
          "when": "false"
        },
        {
          "command": "worktreeExplorer.openWorktreeInNewWindow",
          "when": "false"
        },
        {
          "command": "worktreeExplorer.showInWorktreeExplorer",
          "when": "false"
        },
        {
          "command": "worktreeExplorer.copyCleanupCommand",
          "when": "false"
        },
        {
          "command": "worktreeExplorer.removeWorktree",
          "when": "false"
        },
        {
          "command": "worktreeExplorer.serveViaTunnel",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "worktreeExplorer.chooseFilter",
          "when": "view == worktreeExplorer.files && !worktreeExplorer.filterActive",
          "group": "navigation@3"
        },
        {
          "command": "worktreeExplorer.chooseFilterActive",
          "when": "view == worktreeExplorer.files && worktreeExplorer.filterActive",
          "group": "navigation@3"
        },
        {
          "command": "worktreeExplorer.selectWorktree",
          "when": "view == worktreeExplorer.files",
          "group": "navigation@1"
        },
        {
          "command": "worktreeExplorer.refresh",
          "when": "view == worktreeExplorer.files",
          "group": "navigation@2"
        },
        {
          "command": "worktreeExplorer.openTicketLink",
          "when": "view == worktreeExplorer.files && worktreeExplorer.activeTicketHasUrl",
          "group": "navigation@0"
        },
        {
          "command": "worktreeExplorer.openTicketNotes",
          "when": "view == worktreeExplorer.files && worktreeExplorer.activeTicketHasNotes",
          "group": "1_ticket@1"
        },
        {
          "command": "worktreeExplorer.copyTestCommand",
          "when": "view == worktreeExplorer.files && worktreeExplorer.activeTicketHasTestCommand",
          "group": "1_ticket@2"
        },
        {
          "command": "worktreeExplorer.newFile",
          "when": "view == worktreeExplorer.files && isWorkspaceTrusted",
          "group": "2_creation@1"
        },
        {
          "command": "worktreeExplorer.newFolder",
          "when": "view == worktreeExplorer.files && isWorkspaceTrusted",
          "group": "2_creation@2"
        },
        {
          "command": "worktreeExplorer.copyWorktreePath",
          "when": "view == worktreeExplorer.files",
          "group": "3_worktree@1"
        },
        {
          "command": "worktreeExplorer.revealWorktreeRoot",
          "when": "view == worktreeExplorer.files",
          "group": "3_worktree@2"
        },
        {
          "command": "worktreeExplorer.openSettings",
          "when": "view == worktreeExplorer.files",
          "group": "3_worktree@3"
        },
        {
          "command": "worktreeExplorer.refreshTickets",
          "when": "view == worktreeExplorer.tickets",
          "group": "navigation@1"
        },
        {
          "command": "worktreeExplorer.openTicketOverview",
          "when": "view == worktreeExplorer.files",
          "group": "1_ticket@0"
        }
      ],
      "view/item/context": [
        {
          "command": "worktreeExplorer.newFile",
          "when": "view == worktreeExplorer.files && viewItem == folder && isWorkspaceTrusted",
          "group": "1_creation@1"
        },
        {
          "command": "worktreeExplorer.newFolder",
          "when": "view == worktreeExplorer.files && viewItem == folder && isWorkspaceTrusted",
          "group": "1_creation@2"
        },
        {
          "command": "worktreeExplorer.rename",
          "when": "view == worktreeExplorer.files && isWorkspaceTrusted && viewItem =~ /^(file|folder|symlink)$/",
          "group": "2_modification@1"
        },
        {
          "command": "worktreeExplorer.delete",
          "when": "view == worktreeExplorer.files && isWorkspaceTrusted && viewItem =~ /^(file|folder|symlink)$/",
          "group": "2_modification@2"
        },
        {
          "command": "worktreeExplorer.copyRelativePath",
          "when": "view == worktreeExplorer.files",
          "group": "3_paths@1"
        },
        {
          "command": "worktreeExplorer.copyAbsolutePath",
          "when": "view == worktreeExplorer.files",
          "group": "3_paths@2"
        },
        {
          "command": "worktreeExplorer.revealInOperatingSystem",
          "when": "view == worktreeExplorer.files && viewItem =~ /^(file|folder|symlink)$/",
          "group": "3_paths@3"
        },
        {
          "command": "worktreeExplorer.compareWithBase",
          "when": "view == worktreeExplorer.files && viewItem =~ /^(file|deletedFile)$/",
          "group": "0_compare@1"
        },
        {
          "command": "worktreeExplorer.compareWithMainCheckout",
          "when": "view == worktreeExplorer.files && viewItem == file",
          "group": "0_compare@2"
        },
        {
          "command": "worktreeExplorer.openInMainCheckout",
          "when": "view == worktreeExplorer.files && viewItem == file",
          "group": "0_compare@3"
        }
      ]
    },
    "configuration": {
      "title": "Worktree Explorer",
      "properties": {
        "worktreeExplorer.followScmSelection": {
          "type": "boolean",
          "default": true,
          "description": "Follow the linked worktree selected in Source Control. When disabled, the active worktree only changes via manual selection or the restored selection."
        },
        "worktreeExplorer.restoreLastSelection": {
          "type": "boolean",
          "default": true,
          "description": "Restore the last valid worktree selection when no current linked-worktree SCM selection takes precedence."
        },
        "worktreeExplorer.showHiddenFiles": {
          "type": "boolean",
          "default": true,
          "description": "Show hidden files and folders in the Worktree Explorer view."
        },
        "worktreeExplorer.sortOrder": {
          "type": "string",
          "enum": ["foldersFirst", "mixed", "filesFirst"],
          "default": "foldersFirst",
          "description": "How files and folders are ordered in the Worktree Explorer view."
        },
        "worktreeExplorer.exclude": {
          "type": "object",
          "default": { "**/.git": true, "**/node_modules": true },
          "description": "Glob patterns (in the form \"**/name\") to hide from the Worktree Explorer view. Independent of the built-in Explorer's files.exclude."
        },
        "worktreeExplorer.openFilesInPreview": {
          "type": "boolean",
          "default": true,
          "description": "Open files from the Worktree Explorer view in preview mode."
        },
        "worktreeExplorer.confirmDelete": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before deleting a file or folder."
        },
        "worktreeExplorer.useTrash": {
          "type": "boolean",
          "default": true,
          "description": "Move deleted files and folders to the OS trash instead of deleting them permanently."
        },
        "worktreeExplorer.baseBranch": {
          "type": "string",
          "default": "",
          "description": "Branch that worktrees are compared against. Leave empty to use the first of develop, main, or master that exists."
        },
        "worktreeExplorer.ticket.keyPattern": {
          "type": "string",
          "default": "[A-Z][A-Z0-9]+-\\d+",
          "description": "Regular expression for a ticket key, matched against the worktree's branch name and then its folder name."
        },
        "worktreeExplorer.ticket.urlTemplate": {
          "type": "string",
          "default": "",
          "markdownDescription": "Ticket link with a `{key}` placeholder, for example `https://your-site.atlassian.net/browse/{key}`. Used when the notes file has no valid link. Must use https."
        },
        "worktreeExplorer.ticket.notesFile": {
          "type": "string",
          "default": "CLAUDE.local.md",
          "description": "File name in the worktree root to read ticket details from (summary, link, databases, test command). A bare file name only."
        },
        "worktreeExplorer.ticket.cleanupCommand": {
          "type": "string",
          "default": "",
          "markdownDescription": "Command to copy from a ticket's **Copy Cleanup Command** action, with a `{key}` placeholder (for example a script that drops the ticket's local databases). The extension only copies it; it never runs it."
        },
        "worktreeExplorer.tunnel.serveCommand": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "Command that points your tunnel at a checkout, with a `{target}` placeholder (the ticket key, or `main` for the main checkout) — for example `tiggit serve {target}`. When set, ticket cards show **Serve via tunnel**; it asks for confirmation and runs the command in a new terminal. User settings only."
        },
        "worktreeExplorer.tunnel.siteLink": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "Path to the symlink whose target is the checkout the tunnel serves (for example a Herd site link under `~/Library/Application Support/Herd/config/valet/Sites/`). Used to show which ticket is served and to hide its Serve button. User settings only."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "worktreeExplorerTickets",
          "title": "Tickets",
          "icon": "resources/tickets.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest:fixtures": "node test/setup/createGitFixture.js",
    "pretest": "npm run pretest:fixtures && npm run compile-tests && npm run compile",
    "profile": "node test/setup/createLargeFixture.js && npm run compile-tests && vscode-test --config .vscode-test.perf.mjs",
    "check-types": "tsc --noEmit",
    "lint": "eslint src test media",
    "test": "vscode-test",
    "vsix": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/mocha": "^10.0.9",
    "@types/node": "^20.17.6",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0"
  }
}
